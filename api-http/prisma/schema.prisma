generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  creator
  contestee
}

enum SubmissionStatus {
  pending
  accepted
  wrong_answer
  time_limit_exceeded
  runtime_error
}

enum ContestType {
  practice
  competitive
}

enum Difficulty {
  easy
  medium
  hard
}

enum ContestStatus {
  draft
  published
  cancelled
}

enum AttemptStatus {
  in_progress
  submitted
  timed_out
  abandoned
}

/// Whether a problem is offered outside a contest.
///
/// For `DsaProblem` this gates the standalone practice catalogue; `contest_only`
/// problems are usable inside a contest but never listed for practice. Note this
/// is necessary but not sufficient: a `public` problem is still withheld while it
/// sits in a live or upcoming competitive contest — see
/// problem.repository#practiceableWhere.
///
/// For `McqQuestion` it gates use as a learn question (LEARN_PATHS.md §5.7).
/// There is no MCQ catalogue, so nothing lists them; the value is read by the
/// learn path builder, which refuses to publish a path containing a question a
/// learner is not allowed to see.
enum ProblemVisibility {
  draft
  public
  contest_only
}

/// A user's standing on a problem. `solved` is terminal — once solved, a later
/// wrong answer must not demote it back to `attempted`.
enum SolveStatus {
  attempted
  solved
}

/// The two things a learn question can be. Redundant with which FK is set, and
/// deliberately so: it lets the UI order and filter a lesson's questions without
/// joining two tables. A CHECK constraint keeps the two in agreement — see the
/// `learn_paths` migration.
enum LearnQuestionKind {
  problem
  mcq
}

enum LearnPathStatus {
  draft
  published
  archived
}

/// How a learn question came to be complete. `verified` means the platform saw
/// it happen — all test cases passed, or the MCQ was answered correctly.
/// `self_marked` is the user's own claim about work done elsewhere
/// (LEARN_PATHS.md D3), and is the only kind that can be un-ticked.
enum CompletionSource {
  verified
  self_marked
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  /// Null for accounts that only ever signed in with Google — there is no
  /// password to hash. Any password comparison must treat null as "this account
  /// has no password login", never as a failed compare.
  password String?

  /// Google's stable subject id (`profile.id`). Unique so one Google account
  /// cannot be linked to two users.
  googleId String? @unique

  isVerified Boolean @default(false)
  imageUrl   String?
  role       Role    @default(contestee)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contests            Contest[]            @relation("ContestCreator")
  mcqQuestions        McqQuestion[]
  dsaProblems         DsaProblem[]
  attempts            ContestAttempt[]
  mcqSubmissions      McqSubmission[]
  dsaSubmissions      DsaSubmission[]
  practiceSubmissions PracticeSubmission[]
  practiceDrafts      PracticeDraft[]
  problemStatuses     UserProblemStatus[]
  leaderboard         ContestLeaderboard[]

  learnQuestionProgress UserLearnQuestionProgress[]
  learnLessonProgress   UserLearnLessonProgress[]
  learnModuleProgress   UserLearnModuleProgress[]
  learnPathProgress     UserLearnPathProgress[]
  learnMcqAttempts      LearnMcqAttempt[]

  @@index([role])
  @@map("users")
}

model Contest {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  startTime     DateTime?
  endTime       DateTime?
  maxDurationMs Int?

  type   ContestType   @default(competitive)
  status ContestStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId Int
  creator   User @relation("ContestCreator", fields: [creatorId], references: [id])

  questions      ContestQuestion[]
  leaderboard    ContestLeaderboard[]
  attempts       ContestAttempt[]
  mcqSubmissions McqSubmission[]
  dsaSubmissions DsaSubmission[]

  @@index([creatorId])
  @@index([startTime, endTime])
  @@map("contests")
}

model ContestAttempt {
  id Int @id @default(autoincrement())

  userId    Int
  contestId Int

  currentProblemId Int?

  startedAt  DateTime @default(now())
  deadlineAt DateTime

  submittedAt DateTime?
  durationMs  Int?
  totalPoints Int           @default(0)
  status      AttemptStatus @default(in_progress)

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  mcqSubmissions McqSubmission[]
  dsaSubmissions DsaSubmission[]

  @@index([userId])
  @@index([contestId])
}

model McqQuestion {
  id                 Int    @id @default(autoincrement())
  questionText       String
  options            Json
  correctOptionIndex Int
  points             Int    @default(1)
  maxDurationMs      Int?

  /// Mirrors `DsaProblem.visibility` so both halves of the question bank answer
  /// "may a learner see this?" the same way. Defaults to `draft`: a question is
  /// not exposed outside a contest until someone says so.
  visibility ProblemVisibility @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId Int
  createdBy User @relation(fields: [creatorId], references: [id])

  contestLinks   ContestQuestion[]
  submissions    McqSubmission[]
  learnQuestions LearnQuestion[]

  @@map("mcq_questions")
}

model DsaProblem {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String
  tags        String[] @default([])

  points      Int        @default(100)
  timeLimit   Int        @default(2000)
  memoryLimit Int        @default(256)
  // Non-null so every problem lands in a difficulty filter bucket.
  difficulty  Difficulty @default(medium)

  visibility    ProblemVisibility @default(draft)
  maxDurationMs Int?

  signature    Json
  inputFormat  String?
  outputFormat String?
  constraints  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId Int
  createdBy User @relation(fields: [creatorId], references: [id])

  testCases           TestCase[]
  submissions         DsaSubmission[]
  practiceSubmissions PracticeSubmission[]
  practiceDrafts      PracticeDraft[]
  contestLinks        ContestQuestion[]
  stat                ProblemStat?
  userStatuses        UserProblemStatus[]
  learnQuestions      LearnQuestion[]

  @@index([visibility, difficulty])
  @@index([visibility, createdAt])
  // GIN index so tag filtering (`tags hasSome [...]`) is not a sequential scan.
  @@index([tags], type: Gin)
  // Trigram index so catalogue search (`title ILIKE '%q%'`) can use an index —
  // a plain b-tree can't serve a leading-wildcard match. Needs the pg_trgm
  // extension, created in the accompanying migration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("dsa_problems")
}

model ContestQuestion {
  id        Int @id @default(autoincrement())
  contestId Int
  order     Int

  mcqId Int?
  dsaId Int?

  contest Contest      @relation(fields: [contestId], references: [id])
  mcq     McqQuestion? @relation(fields: [mcqId], references: [id])
  dsa     DsaProblem?  @relation(fields: [dsaId], references: [id])

  @@unique([contestId, mcqId])
  @@unique([contestId, dsaId])
  @@index([contestId])
}

model TestCase {
  id             Int      @id @default(autoincrement())
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())

  problemId Int
  problem   DsaProblem @relation(fields: [problemId], references: [id])

  @@index([problemId])
  @@map("test_cases")
}

model McqSubmission {
  id                  Int      @id @default(autoincrement())
  selectedOptionIndex Int
  isCorrect           Boolean
  pointsEarned        Int      @default(0)
  submittedAt         DateTime @default(now())

  userId     Int
  questionId Int
  contestId  Int
  attemptId  Int

  user     User           @relation(fields: [userId], references: [id])
  question McqQuestion    @relation(fields: [questionId], references: [id])
  contest  Contest        @relation(fields: [contestId], references: [id])
  attempt  ContestAttempt @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([contestId])
  @@index([attemptId])
  @@map("mcq_submissions")
}

model DsaSubmission {
  id              Int              @id @default(autoincrement())
  code            String
  language        String
  status          SubmissionStatus
  pointsEarned    Int              @default(0)
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  executionTime   Int?
  submittedAt     DateTime         @default(now())

  userId    Int
  problemId Int
  contestId Int
  attemptId Int

  user    User           @relation(fields: [userId], references: [id])
  problem DsaProblem     @relation(fields: [problemId], references: [id])
  contest Contest        @relation(fields: [contestId], references: [id])
  attempt ContestAttempt @relation(fields: [attemptId], references: [id])

  // DSA problems allow re-submission (issues.md §4.2); scoring takes the best
  // (MAX pointsEarned) per (attempt, problem), so multiple rows are expected.
  @@index([attemptId, problemId])
  @@index([problemId])
  @@index([contestId])
  @@index([attemptId])
  @@map("dsa_submissions")
}

/// Denormalised per-problem counters backing the catalogue's acceptance-rate
/// sort (PRACTICE_MODE_AND_NAVIGATION.md §4.5).
///
/// Computing these live would mean a COUNT over every submission per row per
/// page load. They're maintained on each verdict instead (stats.service.ts).
/// Exactly one row per DsaProblem — the row is created with the problem and
/// backfilled for pre-existing ones, so the catalogue's `orderBy` never has to
/// deal with a null relation.
model ProblemStat {
  problemId Int @id

  totalSubmissions    Int @default(0)
  acceptedSubmissions Int @default(0)
  /// Distinct users who have solved it at least once.
  solvedBy            Int @default(0)

  /// acceptedSubmissions / totalSubmissions, 0 when there are no submissions.
  /// Stored rather than computed because Prisma cannot `orderBy` an expression.
  acceptanceRate Float @default(0)

  updatedAt DateTime @updatedAt

  problem DsaProblem @relation(fields: [problemId], references: [id])

  @@map("problem_stats")
}

/// A user's solved/attempted standing on a problem, for the catalogue's status
/// filter (§4.5). Counts submissions from both contests and practice: solving a
/// problem in a contest means you have solved it.
model UserProblemStatus {
  userId    Int
  problemId Int

  status   SolveStatus
  solvedAt DateTime?

  firstAttemptedAt DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id])
  problem DsaProblem @relation(fields: [problemId], references: [id])

  @@id([userId, problemId])
  @@index([userId, status])
  @@map("user_problem_status")
}

/// A standalone practice submission — no contest, no attempt, no score.
///
/// Deliberately a separate table from `DsaSubmission` rather than nullable
/// contest/attempt FKs (PRACTICE_MODE_AND_NAVIGATION.md §4.1): the two share the
/// judge *pipeline* but not their *invariants*. A contest submission is scored,
/// deadline-bound and ranked; a practice submission is none of those. Keeping
/// them apart means the contest tables keep their NOT NULL guarantees and no
/// contest aggregate has to learn to exclude practice rows.
model PracticeSubmission {
  id              Int              @id @default(autoincrement())
  code            String
  language        String
  status          SubmissionStatus
  testCasesPassed Int              @default(0)
  totalTestCases  Int              @default(0)
  executionTime   Int?
  submittedAt     DateTime         @default(now())

  userId    Int
  problemId Int

  user    User       @relation(fields: [userId], references: [id])
  problem DsaProblem @relation(fields: [problemId], references: [id])

  // Submission history for a user on one problem (the detail page's list).
  @@index([userId, problemId, submittedAt])
  // Boot reconciliation sweeps `status = 'pending'` (jobs/reconcile.ts).
  @@index([status])
  @@map("practice_submissions")
}

model ContestLeaderboard {
  id          Int @id @default(autoincrement())
  contestId   Int
  userId      Int
  totalPoints Int
  rank        Int

  contest Contest @relation(fields: [contestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([contestId, userId])
}

// ---------------------------------------------------------------------------
// Learn paths (LEARN_PATHS.md)
//
// Path → Module → Lesson → Question, where a *question* is the only atom that
// can be completed. Containers are complete when all their children are; there
// is no reading credit, no participation credit, nothing else that moves a
// progress bar. That rule is why the numbers on the learn pages can be trusted,
// so treat it as an invariant rather than a default.
// ---------------------------------------------------------------------------

/// A curated curriculum. Several can exist and a user picks between them;
/// enrolment is implicit — a `UserLearnPathProgress` row appears the first time
/// the path is opened (LEARN_PATHS.md D8, §5.2).
model LearnPath {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  title       String
  description String
  status      LearnPathStatus @default(draft)
  order       Int             @default(0)
  isFeatured  Boolean         @default(false)

  /// Fraction of a module's questions needed before the *next* module stops
  /// being dimmed (§5.4). Per-path so a short path can demand more. `0` turns
  /// soft gating off for the whole path without a code change.
  unlockThreshold Float @default(0.6)

  /// Denormalised totals. The gallery renders one card per path and would
  /// otherwise count questions across every path on every load. Maintained by
  /// the admin write path — a stale total here is a wrong denominator, which is
  /// the trust problem in §5.1 arriving by another route.
  totalQuestions Int @default(0)
  totalModules   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules  LearnModule[]
  progress UserLearnPathProgress[]

  @@index([status, order])
  @@map("learn_paths")
}

/// A top-level section ("Binary Search"). The level the full milestone moment
/// fires on, and the only level soft gating applies to (§3.2).
model LearnModule {
  id      Int     @id @default(autoincrement())
  pathId  Int
  slug    String
  title   String
  summary String?
  order   Int

  totalQuestions Int @default(0)

  path     LearnPath                 @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lessons  LearnLesson[]
  progress UserLearnModuleProgress[]

  @@unique([pathId, slug])
  @@index([pathId, order])
  @@map("learn_modules")
}

/// A group of questions with optional teaching prose ("Search Space").
///
/// `body` never gates and never counts (D4) — a lesson is complete when its
/// questions are, whether or not anyone read a word of it. Rendered through a
/// sanitising markdown pipeline (§5.8); it is creator-authored but still
/// untrusted input into every learner's DOM.
model LearnLesson {
  id       Int     @id @default(autoincrement())
  moduleId Int
  slug     String
  title    String
  body     String?
  order    Int

  totalQuestions Int @default(0)

  module    LearnModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions LearnQuestion[]
  progress  UserLearnLessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
  @@map("learn_lessons")
}

/// The atom. Exactly one of `problemId` / `mcqId` is set, and `kind` agrees with
/// whichever it is — enforced by a CHECK constraint in the migration, because
/// two nullable FKs otherwise permit a question that is nothing, a question that
/// is two things, or a question whose `kind` lies about its target.
model LearnQuestion {
  id       Int               @id @default(autoincrement())
  lessonId Int
  kind     LearnQuestionKind
  order    Int

  problemId Int?
  mcqId     Int?

  /// Optional curator framing ("focus on the invariant, not the code").
  note String?

  lesson LearnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// `Restrict`, not Prisma's default `SetNull` for an optional relation.
  /// SetNull would blank `problemId` while `kind` still said `problem`, which
  /// the CHECK constraint then rejects — turning "you deleted a problem that a
  /// path uses" into an opaque constraint violation at an unrelated call site.
  /// Restrict says so directly, and a problem in a curriculum should not be
  /// silently deletable anyway.
  problem DsaProblem?  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  mcq     McqQuestion? @relation(fields: [mcqId], references: [id], onDelete: Restrict)
  progress UserLearnQuestionProgress[]
  attempts LearnMcqAttempt[]

  @@unique([lessonId, problemId])
  @@unique([lessonId, mcqId])
  @@index([lessonId, order])
  /// Drives the verdict fan-out (§5.2): "every learn question referencing this
  /// problem". A problem may appear in many paths and all of them must tick.
  @@index([problemId])
  @@map("learn_questions")
}

/// Per-question standing. Rows exist only for *completed* questions — absence
/// means "not started", so a 474-question path costs zero rows until the user
/// actually does something.
model UserLearnQuestionProgress {
  userId     Int
  questionId Int

  source      CompletionSource
  completedAt DateTime         @default(now())

  user     User          @relation(fields: [userId], references: [id])
  question LearnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId])
  @@map("user_learn_question_progress")
}

model UserLearnLessonProgress {
  userId   Int
  lessonId Int

  completedQuestions Int       @default(0)
  completedAt        DateTime?

  /// Null until the inline lesson milestone has been shown. Server-side rather
  /// than localStorage so a phone and a laptop don't each celebrate once (§5.5).
  celebratedAt DateTime?

  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  lesson LearnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId])
  @@map("user_learn_lesson_progress")
}

model UserLearnModuleProgress {
  userId   Int
  moduleId Int

  completedQuestions Int       @default(0)
  completedLessons   Int       @default(0)
  completedAt        DateTime?
  celebratedAt       DateTime?

  /// Monotonic: once unlocked, never re-locked — even if the curriculum grows
  /// underneath the user and drops them back below the threshold (§5.4). Also
  /// written by "Open anyway", which is a deliberate one-way door.
  unlockedAt DateTime?

  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id])
  module LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
  @@map("user_learn_module_progress")
}

/// Denormalised per-(user, path) counters so the gallery is one query regardless
/// of how many paths exist or how big they are.
///
/// The existence of this row doubles as "this user has opened this path" — the
/// latch that stops the historical backfill in §5.2 from re-running on every
/// page load. Enrolment marker and backfill gate are one mechanism on purpose.
model UserLearnPathProgress {
  userId Int
  pathId Int

  completedQuestions Int @default(0)
  /// Subset of `completedQuestions` — powers "218 verified · 6 self-marked".
  verifiedQuestions  Int @default(0)
  completedLessons   Int @default(0)
  completedModules   Int @default(0)

  /// Where "Continue →" goes. Recomputed on each completion.
  currentModuleId   Int?
  currentLessonId   Int?
  currentQuestionId Int?

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastActiveAt DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id])
  path LearnPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@id([userId, pathId])
  @@index([userId, lastActiveAt])
  @@map("user_learn_path_progress")
}

/// An MCQ answer outside a contest.
///
/// Separate from `McqSubmission` for the same reason `PracticeSubmission` is
/// separate from `DsaSubmission` (PRACTICE_MODE_AND_NAVIGATION.md §4.1): no
/// attempt, no contest, no score, and retries are allowed. Folding these into
/// the contest table would mean every contest aggregate learning to exclude
/// them, and `@@unique([attemptId, questionId])` has no meaning here.
model LearnMcqAttempt {
  id                  Int      @id @default(autoincrement())
  userId              Int
  questionId          Int
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  question LearnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId, answeredAt])
  @@map("learn_mcq_attempts")
}

model EmailOtp {
  id             String   @id @default(cuid())
  email          String
  otpHash        String
  expiresAt      DateTime
  used           Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([email, used])
  @@index([expiresAt])
}

model DraftAnswer {
  id        Int @id @default(autoincrement())
  attemptId Int
  problemId Int

  code      String?
  language  String?
  mcqOption Int?

  updatedAt DateTime @updatedAt

  @@unique([attemptId, problemId])
}

/// Practice code-in-progress, keyed by (user, problem) since practice has no
/// attempt to hang a draft off (PRACTICE_MODE_AND_NAVIGATION.md §4.7).
///
/// A separate table rather than making `DraftAnswer.attemptId` nullable: Postgres
/// treats NULLs as distinct, so `@@unique([attemptId, problemId])` would stop
/// enforcing anything for practice rows and silently allow duplicate drafts.
model PracticeDraft {
  id        Int @id @default(autoincrement())
  userId    Int
  problemId Int

  code     String
  language String

  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id])
  problem DsaProblem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
  @@map("practice_drafts")
}
