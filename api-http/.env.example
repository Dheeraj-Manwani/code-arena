# ── api-http (Economy Service: single process, no Redis) ──
# REST + WebSocket + in-process judge all run in ONE process on ONE port.
# Dependencies: PostgreSQL + Judge0 (external API). No Redis.

# Core (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/code_arena
DIRECT_URL=postgresql://user:pass@localhost:5432/code_arena
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me

# Which backend executes submissions (SELF_HOSTED_JUDGE.md).
#   judge0 — Judge0 via RapidAPI (requires the three JUDGE0_* vars below)
#   local  — container per submission, needs Docker + `pnpm run judge-images`
# "shadow" arrives in Phase 5. An unrecognised value fails at boot rather than
# at the first submission of a contest.
JUDGE_BACKEND=judge0

# Local backend limits (only used when JUDGE_BACKEND=local). Defaults shown.
# Compile/run seconds are enforced inside the container by GNU timeout; the wall
# timeout is a Node-side backstop for a wedged daemon and must exceed them both
# plus container startup.
LOCAL_COMPILE_TIMEOUT_S=10
LOCAL_RUN_TIMEOUT_S=5
LOCAL_WALL_TIMEOUT_MS=30000
LOCAL_OUTPUT_CAP_BYTES=1048576   # kill a program that floods stdout/stderr

# Shadow mode caps (only used when JUDGE_BACKEND=shadow). Judge0 stays
# authoritative; the local backend runs alongside and is compared. Small on
# purpose — shadow work shares a box with the API, and past these limits extra
# comparisons are DROPPED rather than queued.
SHADOW_MAX_CONCURRENCY=2
SHADOW_MAX_QUEUED=32

# Judge0 (required while JUDGE_BACKEND=judge0) — the judge pipeline runs
# IN-PROCESS, so these live here (they used to be in judge-worker/.env).
JUDGE0_API_URL=https://judge029.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge029.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=replace-me

# HTTP + realtime — one port serves both REST and WebSocket (Phase 4).
# Point the frontend's VITE_API_URL and VITE_WS_URL at this same origin, e.g.
# VITE_API_URL=http://localhost:3000  VITE_WS_URL=ws://localhost:3000
PORT=3000
ALLOWED_HOSTS=http://localhost:5173
NODE_ENV=development

# In-process judge tuning (Phase 6). Defaults shown.
WORKER_CONCURRENCY=4          # max parallel judgings
JUDGE_RATE_MAX=10             # Judge0 calls allowed per window (RapidAPI rate limit)
JUDGE_RATE_WINDOW_MS=1000
RUN_MAX_CONCURRENCY=8         # max concurrent /api/run executions
RUN_TIMEOUT_MS=35000          # per-run timeout

# Email (optional; required for OTP/reset in production)
RESEND_API_KEY=

# ── Google OAuth (optional) ──
# Leave all three blank to run without Google sign-in: the app boots normally and
# /api/auth/google returns 501. Setting only SOME of them is a config error and
# fails fast at boot.
#
# Get them from https://console.cloud.google.com → APIs & Services → Credentials
# → OAuth 2.0 Client ID (type: Web application), then add
# GOOGLE_CALLBACK_URL verbatim under "Authorised redirect URIs". Google matches
# it exactly — scheme, port and trailing slash all count.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Where the OAuth callback sends the browser once the refresh cookie is set.
# This is the SPA's origin, not the API's.
FRONTEND_URL=http://localhost:5173

# NOTE: no REDIS_*, no BACKEND_INTERNAL_SECRET, no WS_PORT, no USE_REDIS — all
# removed. Submit judging uses an in-process pool with DB reconciliation on boot;
# runs execute inline; realtime is an in-process event bus.
