{
  "name": "code-arena",
  "private": true,
  "version": "1.0.0",
  "description": "Code Arena monorepo — root launcher. Each service manages its own dependencies.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:web": "node scripts/dev.mjs web",
    "dev:admin": "node scripts/dev.mjs admin",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres"
  }
}
